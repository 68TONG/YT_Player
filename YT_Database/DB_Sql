SELECT DISTINCT F_Info.*
  FROM MusicFileInfo AS F_Info
       CROSS JOIN
       json_tree(F_Info.Tags) 
 WHERE json_tree.value GLOB '我推*';-- 查询 PlayCount > ? 数据

SELECT DISTINCT F_Info.*
  FROM MusicFileInfo AS F_Info
 WHERE F_Info.PlayCount > 0;
 
SELECT DISTINCT F_Info.*
  FROM MusicFileInfo AS F_Info
 WHERE F_Info.CoverHashValue = 'be2aed021a53b3113791d22295dcddbb';